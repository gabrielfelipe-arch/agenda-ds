# Porta interna do servidor
PORT=8080

# URL pública COMPLETA por onde o sistema é acessado.
# Precisa bater exatamente com o endereço do navegador — é usada no OAuth do Google
# e como origem da biometria (WebAuthn).
# Exemplo Tailscale: https://minha-maquina.tailXXXX.ts.net
PUBLIC_URL=http://localhost:8080

# Segredo dos tokens de sessão. Gere um valor aleatório longo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-em-producao

# Administrador criado automaticamente no primeiro boot
ADMIN_EMAIL=admin@agenda5588.local
ADMIN_PASSWORD=troque-esta-senha

# Nome exibido no prompt de biometria do aparelho
RP_NAME=Agenda 5588

# Origens extras aceitas na biometria (separadas por vírgula), se houver
# WEBAUTHN_ORIGINS=https://outro-host.ts.net

TZ=America/Sao_Paulo
NODE_ENV=production
